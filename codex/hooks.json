{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$PLUGIN_ROOT/codex/session.sh\""
          },
          {
            "type": "command",
            "command": "\"$PLUGIN_ROOT/codex/helper.sh\"",
            "async": true,
            "timeout": 2592000
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$PLUGIN_ROOT/codex/prompt.sh\""
          },
          {
            "type": "command",
            "command": "\"$PLUGIN_ROOT/codex/helper.sh\"",
            "async": true,
            "timeout": 2592000
          }
        ]
      }
    ]
  }
}
