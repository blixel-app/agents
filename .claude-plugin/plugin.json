{
  "name": "blixel",
  "version": "0.9.1",
  "description": "Rooms, meeting chat, window sharing, transcripts, hooks and agent handoffs through the blixel CLI.",
  "author": {
    "name": "Blixel",
    "url": "https://blixel.app"
  },
  "homepage": "https://blixel.app",
  "repository": "https://github.com/blixel-app/skills",
  "license": "MIT",
  "keywords": [
    "blixel",
    "meetings",
    "transcripts",
    "screen sharing"
  ],
  "types": "./types/index.d.ts",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/skills/connect-agent/scripts/session-start.sh\""
          }
        ]
      }
    ]
  }
}
